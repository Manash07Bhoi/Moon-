    { "type": "silence", "start": 200.5, "end": 203.5 },
    { "type": "line", "id": "l21", "start": 203.5, "end": 208.0, "text": "Kebe Ta Chhuin Huena..", "cue": "firefly-gather", "act": "galaxy", "emotion": "sadness", "translation": "Never been able to touch" },
    { "type": "silence", "start": 208.0, "end": 211.5 },
    { "type": "line", "id": "l21b", "start": 211.5, "end": 216.5, "text": "Kebe Ta Chhuin Huena...", "cue": "petal-assemble", "act": "galaxy", "emotion": "sadness", "translation": "Never been able to touch..." },

    { "type": "silence", "start": 216.5, "end": 218.0 },
    { "type": "line", "id": "l22", "start": 218.0, "end": 223.5, "text": "Janha Ru Sina Jochhana Jhare", "cue": "lake-reflection-reveal", "act": "dawn", "emotion": "peace", "translation": "From the moon, moonlight falls into the heart" },
    { "type": "silence", "start": 223.5, "end": 226.5 },
    { "type": "line", "id": "l23", "start": 226.5, "end": 231.5, "text": "Kie Se Bhijuchhi Kie Ta Jale", "cue": "rain-ripple-reveal", "act": "dawn", "emotion": "peace", "translation": "Someone is getting drenched, someone burns" },
    { "type": "silence", "start": 231.5, "end": 234.5 },
    { "type": "line", "id": "l24", "start": 234.5, "end": 239.5, "text": "Mana Ta Jebe Jale Re Mita", "cue": "mist-condense", "act": "dawn", "emotion": "melancholy", "translation": "When the heart burns, my friend" },
    { "type": "silence", "start": 239.5, "end": 242.5 },
    { "type": "line", "id": "l25", "start": 242.5, "end": 247.5, "text": "Gae Se Luha Ra Lahu Ra Gita", "cue": "cloud-part-reveal", "act": "dawn", "emotion": "melancholy", "translation": "It sings a song of tears and blood" },
    { "type": "silence", "start": 247.5, "end": 250.5 },
