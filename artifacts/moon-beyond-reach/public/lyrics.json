    { "type": "silence", "start": 37.5, "end": 40.5 },
    { "type": "line", "id": "l3", "start": 40.5, "end": 44.5, "text": "Dekhi Se Hue Sina", "cue": "firefly-gather", "act": "moon", "emotion": "sadness", "translation": "Seeing it, the heart fills" },
    { "type": "silence", "start": 44.5, "end": 47.5 },
    { "type": "line", "id": "l4", "start": 47.5, "end": 51.5, "text": "Kebeta Chhuin Huena", "cue": "mist-condense", "act": "moon", "emotion": "sadness", "translation": "Yet never been able to touch" },
    { "type": "silence", "start": 51.5, "end": 54.5 },
    { "type": "line", "id": "l4b", "start": 54.5, "end": 58.5, "text": "Kebeta Chhuin Huena", "cue": "petal-assemble", "act": "moon", "emotion": "sadness", "translation": "Never been able to touch..." },
    { "type": "silence", "start": 58.5, "end": 61.0 },
    { "type": "line", "id": "l5", "start": 61.0, "end": 66.0, "text": "Se Janha Ku Tike Dekhibaku", "cue": "cloud-part-reveal", "act": "moon", "emotion": "yearning", "translation": "Just to see that moon for a moment" },
    { "type": "silence", "start": 66.0, "end": 69.5 },
    { "type": "line", "id": "l6", "start": 69.5, "end": 74.5, "text": "Kahinki Kejani E Akhiku", "cue": "rain-ripple-reveal", "act": "moon", "emotion": "melancholy", "translation": "Why does this eye, for some reason" },
    { "type": "silence", "start": 74.5, "end": 78.0 },
    { "type": "line", "id": "l7", "start": 78.0, "end": 82.5, "text": "Heichhi Aji Mana", "cue": "lake-reflection-reveal", "act": "moon", "emotion": "melancholy", "translation": "Has become so restless today" },
    { "type": "silence", "start": 82.5, "end": 85.5 },
    { "type": "line", "id": "l8", "start": 85.5, "end": 89.5, "text": "Na Dekhi Rahi Huena", "cue": "shooting-star-trail", "act": "moon", "emotion": "longing", "translation": "Could not stop looking" },
    { "type": "silence", "start": 89.5, "end": 92.5 },
    { "type": "line", "id": "l8b", "start": 92.5, "end": 97.0, "text": "Na Dekhi Rahi Huena...", "cue": "aurora-write", "act": "moon", "emotion": "longing", "translation": "Could not stop looking..." },

    { "type": "silence", "start": 97.0, "end": 101.0 },
    { "type": "line", "id": "l9", "start": 101.0, "end": 106.0, "text": "Dura Akasara Janha Tie", "cue": "constellation-form", "act": "water", "emotion": "acceptance", "translation": "That moon in the distant sky" },
    { "type": "silence", "start": 106.0, "end": 109.5 },
    { "type": "line", "id": "l10", "start": 109.5, "end": 114.5, "text": "Dui Akhire Se Swapna Tie...", "cue": "moon-beam-write", "act": "water", "emotion": "acceptance", "translation": "That dream in these two eyes..." },

    { "type": "silence", "start": 114.5, "end": 120.0 },
    { "type": "line", "id": "l11", "start": 120.0, "end": 125.5, "text": "Se Janha Sina Bhari Sundara", "cue": "firefly-gather", "act": "grove", "emotion": "wonder", "translation": "That moon, filling the heart with beauty" },
    { "type": "silence", "start": 125.5, "end": 128.5 },
    { "type": "line", "id": "l12", "start": 128.5, "end": 134.0, "text": "Adhei Akshyara Prema Je Tara", "cue": "petal-assemble", "act": "grove", "emotion": "yearning", "translation": "Half a word, that is love" },
    { "type": "silence", "start": 134.0, "end": 137.0 },
    { "type": "line", "id": "l13", "start": 137.0, "end": 142.0, "text": "Prema Je Tara Adha Adhura", "cue": "mist-condense", "act": "grove", "emotion": "sadness", "translation": "That love, half and incomplete" },
    { "type": "silence", "start": 142.0, "end": 145.0 },
    { "type": "line", "id": "l14", "start": 145.0, "end": 150.0, "text": "Adha Adhura Mo Gapa Para", "cue": "lake-reflection-reveal", "act": "grove", "emotion": "sadness", "translation": "Incomplete, my unspoken story" },
    { "type": "silence", "start": 150.0, "end": 153.0 },
    { "type": "line", "id": "l15", "start": 153.0, "end": 158.0, "text": "Se Gapa Kahaku Kahiba Pain", "cue": "cloud-part-reveal", "act": "grove", "emotion": "melancholy", "translation": "To whom shall I tell this story" },
    { "type": "silence", "start": 158.0, "end": 161.0 },
    { "type": "line", "id": "l16", "start": 161.0, "end": 166.0, "text": "Mana Hela Kain Jane Nahi", "cue": "rain-ripple-reveal", "act": "grove", "emotion": "melancholy", "translation": "The heart felt something, know not why" },
    { "type": "silence", "start": 166.0, "end": 169.5 },
    { "type": "line", "id": "l17", "start": 169.5, "end": 175.0, "text": "Tathapi Nakahi Rahi Ta Huena", "cue": "galaxy-dust-form", "act": "grove", "emotion": "acceptance", "translation": "Yet could not remain without telling" },

    { "type": "silence", "start": 175.0, "end": 180.0 },
